# sanitization.py
import re
from datetime import datetime
from typing import Optional

class RequirementSanitizer:
    """Локальный препроцессор для обезличивания требований перед отправкой в LLM"""
    
    PATTERNS = {
        'inn': (r'\b\d{10}\b', '[INN_PATTERN]'),
        'kpp': (r'\b\d{9}\b', '[KPP_PATTERN]'),
        'email': (r'\b[\w.-]+@[\w.-]+\.\w+\b', '[EMAIL_PATTERN]'),
        'phone': (r'\+7\s?\(?\d{3}\)?\s?\d{3}-?\d{2}-?\d{2}', '[PHONE_PATTERN]'),
        'sum_rub': (r'\b\d{1,3}(?:\s?\d{3})+(?:\.\d{2})?\s?руб\.?', '[SUM_LIMIT]'),
        'date_ddmmyyyy': (r'\b\d{2}\.\d{2}\.\d{4}\b', '[DATE_PATTERN]'),
        'ip_address': (r'\b(?:\d{1,3}\.){3}\d{1,3}\b', '[IP_PATTERN]'),
        'uuid': (r'\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b', '[UUID_PATTERN]'),
    }
    
    def __init__(self, custom_patterns: Optional[dict] = None):
        if custom_patterns:
            self.PATTERNS.update(custom_patterns)
    
    def sanitize(self, text: str) -> str:
        result = text
        for pattern, replacement in self.PATTERNS.values():
            result = re.sub(pattern, replacement, result, flags=re.IGNORECASE)
        # Замена имён компаний и людей (простая эвристика)
        result = re.sub(r'ООО\s+["\']?[\w\s\-]+["\']?', '[COMPANY_PLACEHOLDER]', result)
        result = re.sub(r'[А-Я][а-я]+\s+[А-Я]\.[А-Я]\.', '[PERSON_PLACEHOLDER]', result)
        return result
    
    def sanitize_file(self, input_path: str, output_path: str):
        with open(input_path, 'r', encoding='utf-8') as f:
            content = f.read()
        sanitized = self.sanitize(content)
        with open(output_path, 'w', encoding='utf-8') as f:
            f.write(sanitized)

# Пример использования
if __name__ == '__main__':
    sanitizer = RequirementSanitizer()
    raw = 'Клиент ООО «Вектор», ИНН 7701234567, сумма 15 000 000 руб.'
    print(sanitizer.sanitize(raw))
    # Вывод: Клиент [COMPANY_PLACEHOLDER], ИНН [INN_PATTERN], сумма [SUM_LIMIT].
